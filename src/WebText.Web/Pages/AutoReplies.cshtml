@page
@model WebText.Web.Pages.AutoRepliesModel
@inject WebText.Web.Services.TimeDisplay Time
@{
    ViewData["Title"] = "Auto-replies";
}

<div class="page-head"><h1>Auto-replies</h1></div>
<p class="muted">When a client texts one of these keywords, the reply below is sent automatically, at any hour.
    The client's text and the reply both appear in their thread like any other message.</p>

@if (!Model.Enabled)
{
    <div class="banner warn">Auto-replies are turned off on the Settings page, so none are being sent.</div>
}

<div class="two-col">
    <div>
        <table class="grid">
            <thead><tr><th>Keyword</th><th>Matches</th><th>Reply</th><th class="num" title="Auto-replies sent / different phone numbers they went to">Times sent</th><th class="num">Unique numbers</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr class="@(r.IsActive ? "" : "inactive")">
                        <td class="nowrap"><b>@r.Keyword</b>
                            @if (!r.IsActive) { <span class="tag">off</span> }
                            @if (!string.IsNullOrEmpty(r.Notes)) { <div class="muted small">@r.Notes</div> }</td>
                        <td class="nowrap small">@WebText.Web.Pages.AutoRepliesModel.MatchLabel(r.Match)</td>
                        <td class="small">@r.Reply</td>
                        @{ var use = Model.UsageFor(r.Keyword); }
                        <td class="num small nowrap">@use.Times.ToString("N0")
                            @if (r.LastUsedAtUtc is { } lu) { <div class="muted" title="Last sent">@Time.Local(lu, "M/d h:mm tt")</div> }</td>
                        <td class="num small nowrap">@use.Numbers.ToString("N0")</td>
                        <td class="nowrap right">
                            @if (Model.CanEdit)
                            {
                                <a class="btn small" href="?edit=@r.Id">Edit</a>
                                <form method="post" asp-page-handler="Toggle" asp-route-id="@r.Id" class="inline">
                                    <button class="btn small subtle">@(r.IsActive ? "Turn off" : "Turn on")</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="inline"
                                      onsubmit="return confirm('Delete the auto-reply for @r.Keyword?')">
                                    <button class="btn small subtle">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="muted center">No auto-replies yet.</td></tr>
                }
            </tbody>
        </table>
        <p class="muted small">Times sent and unique numbers count every auto-reply in the message history, all time.
            If a keyword is renamed, its counts start again under the new name.</p>

        <form method="get" class="card form" style="margin-top:16px">
            <h3>Try it</h3>
            <label><span>Type a text as a client would send it</span>
                <input name="TestText" value="@Model.TestText" placeholder="e.g. joke" autocomplete="off" /></label>
            <button class="btn">Check</button>
            @if (Model.Tested)
            {
                @if (Model.TestMatch is { } m)
                {
                    <div class="banner info" style="margin-top:10px">Matches <b>@m.Keyword</b> (@WebText.Web.Pages.AutoRepliesModel.MatchLabel(m.Match).ToLower()).
                        The client would get:<br /><i>@m.Reply</i></div>
                }
                else
                {
                    <div class="banner warn" style="margin-top:10px">No auto-reply matches. The text would wait in the inbox for staff.</div>
                }
            }
        </form>

        <div class="card" style="margin-top:16px" id="history">
            <h3>Change history</h3>
            <form method="get" class="inline-form" action="#history">
                <input name="HistoryKeyword" value="@Model.HistoryKeyword" placeholder="Filter by keyword" autocomplete="off" />
                <button class="btn small">Filter</button>
                @if (!string.IsNullOrWhiteSpace(Model.HistoryKeyword)) { <a class="btn small subtle" href="/AutoReplies#history">Clear</a> }
                <a class="btn small subtle" asp-page-handler="HistoryCsv" asp-route-HistoryKeyword="@Model.HistoryKeyword">Export CSV</a>
            </form>
            <table class="grid" style="margin-top:10px">
                <thead><tr><th>When</th><th>Who</th><th>Keyword</th><th>What</th></tr></thead>
                <tbody>
                    @foreach (var c in Model.History)
                    {
                        <tr>
                            <td class="small nowrap">@Time.Local(c.ChangedAtUtc, "M/d/yyyy h:mm tt")</td>
                            <td class="small nowrap">@c.ChangedBy</td>
                            <td class="small nowrap"><b>@c.Keyword</b></td>
                            <td class="small"><b>@WebText.Web.Pages.AutoRepliesModel.ActionLabel(c.Action)</b>
                                @if (!string.IsNullOrEmpty(c.Details)) { <div class="muted" style="white-space:pre-line">@c.Details</div> }</td>
                        </tr>
                    }
                    @if (!Model.History.Any())
                    {
                        <tr><td colspan="4" class="muted center">No changes recorded@(string.IsNullOrWhiteSpace(Model.HistoryKeyword) ? "" : " for that keyword").</td></tr>
                    }
                </tbody>
            </table>
            @if (!Model.AllHistory && Model.History.Count == 25)
            {
                <p class="small"><a href="?AllHistory=true&HistoryKeyword=@Uri.EscapeDataString(Model.HistoryKeyword ?? "")#history">Show more (up to 1,000)</a>
                    or export the CSV for everything.</p>
            }
        </div>
    </div>

    <aside>
        @if (!Model.CanEdit)
        {
            <div class="card"><p class="muted">You don't have access to change auto-replies.</p></div>
        }
        else
        {
            <form method="post" asp-page-handler="Save" class="card form">
                <h3>@(Model.EditId == null ? "New auto-reply" : "Edit auto-reply")</h3>
                <input type="hidden" name="EditId" value="@Model.EditId" />

                <label><span>Keyword</span>
                    <input name="Keyword" value="@Model.Keyword" maxlength="50" placeholder="e.g. JOKE, HOURS, DOCS" autocomplete="off" />
                    @if (Model.Errors.TryGetValue("Keyword", out var ek)) { <span class="error-text">@ek</span> }
                </label>

                <label><span>Reply when the text…</span>
                    <select name="Match">
                        <option value="0" selected="@(Model.Match == KeywordMatch.Exact)">is exactly the keyword (recommended)</option>
                        <option value="1" selected="@(Model.Match == KeywordMatch.FirstWord)">starts with the keyword</option>
                        <option value="2" selected="@(Model.Match == KeywordMatch.Anywhere)">contains the keyword anywhere</option>
                    </select>
                </label>
                <p class="muted small">Upper/lower case, extra spaces and punctuation are ignored, so "Joke!" matches JOKE.
                    A keyword can be more than one word (e.g. STORE HOURS).
                    "Anywhere" can fire on ordinary conversation (a client writing "no joke, I need help" would get the reply),
                    so use it only for unusual words.</p>

                <label><span>Reply</span>
                    <textarea name="Reply" id="ar-reply" rows="5" maxlength="1600">@Model.Reply</textarea>
                    @if (Model.Errors.TryGetValue("Reply", out var er)) { <span class="error-text">@er</span> }
                </label>
                <p class="muted small">Merge fields: <code>{FirstName}</code> <code>{LastName}</code> <code>{FullName}</code> (left blank
                    for numbers that aren't linked to a client yet) · <span id="ar-count"></span></p>

                <label><span>Don't send this reply to the same client again within (minutes)</span>
                    <input name="CooldownMinutes" type="number" min="0" max="10080" value="@Model.CooldownMinutes" />
                    @if (Model.Errors.TryGetValue("CooldownMinutes", out var ec)) { <span class="error-text">@ec</span> }
                </label>

                <label class="check"><input type="checkbox" name="MarkHandled" value="true" checked="@Model.MarkHandled" />
                    <span>Mark the client's text as handled (it won't add to the unread count)</span></label>
                <input type="hidden" name="MarkHandled" value="false" />
                <label class="check"><input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" />
                    <span>On</span></label>
                <input type="hidden" name="IsActive" value="false" />

                <label><span>Notes (staff only, optional)</span>
                    <input name="Notes" value="@Model.Notes" maxlength="500" /></label>

                <div class="form-foot">
                    <button class="btn primary">Save</button>
                    @if (Model.EditId != null) { <a class="btn subtle" href="/AutoReplies">Cancel</a> }
                </div>
            </form>

            <div class="card" style="margin-top:16px">
                <h3>Good to know</h3>
                <ul class="small">
                    <li>STOP, START, HELP and similar words are reserved: STOP/START change a client's opt-out status, and HELP is a standard carrier keyword.</li>
                    <li>Clients who replied STOP never get auto-replies.</li>
                    <li>At most @Model.MaxPerHour auto-replies per client per hour (admins can change this on the Settings page), so the system can't get into a loop with another automated number.</li>
                    <li>Auto-replies show in threads and the message log as "Auto-reply (KEYWORD)", and are counted separately in reports.</li>
                    <li>Keep replies in line with what you described in your 10DLC campaign registration; carriers can block messages that don't match.</li>
                </ul>
            </div>
        }
    </aside>
</div>

@section Scripts {
<script>
(function () {
    const body = document.getElementById("ar-reply"), count = document.getElementById("ar-count");
    if (!body) return;
    const upd = () => { const s = TT.segments(body.value.replace(/\{(FirstName|LastName|FullName)\}/gi, "Xxxxxxxx"));
        count.textContent = body.value ? `~${s.chars} chars · ${s.segments} SMS segment${s.segments === 1 ? "" : "s"}` : ""; };
    body.addEventListener("input", upd); upd();
})();
</script>
}
