{
  "Instance": {
    "Name": "WebText"
  },
  "//": "Only the instance name and the database connection live here. Everything else (Telnyx, AD groups, time zone...) is set by an admin on the Settings page and stored in SQL.",
  "ConnectionStrings": {
    "WebText": "Server=YOUR-SQL-SERVER;Database=WebText;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "Provider": "SqlServer",
    "CreateIfMissing": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
